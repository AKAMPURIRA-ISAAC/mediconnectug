# ── Copy this file to .env and fill in your values ──────────────────────────
# Get these from your Supabase project → Settings → Database → Connection string

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Secret for signing JWT tokens — use any long random string
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars

# Port (Render sets this automatically; 3001 for local)
PORT=3001

