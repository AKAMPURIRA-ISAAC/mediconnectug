<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Reschedule Appointment"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:background="#F0F4F8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Current Appointment Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF3E0">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="20sp"
                        android:layout_marginEnd="10dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Appointment"
                            android:textSize="12sp"
                            android:textColor="#E65100"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvCurrentDateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mon, Oct 24 • 09:30 AM"
                            android:textSize="13sp"
                            android:textColor="#BF360C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Doctor Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E3F2FD">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/log"
                            android:scaleType="centerCrop"
                            android:contentDescription="Doctor" />
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:id="@+id/tvRescheduleDoctorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. Sarah Johnson"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#212121" />
                        <TextView
                            android:id="@+id/tvRescheduleSpecialty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cardiologist"
                            android:textSize="13sp"
                            android:textColor="#546E7A"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:id="@+id/tvRescheduleFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 50,000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1565C0" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="per session"
                            android:textSize="11sp"
                            android:textColor="#90A4AE" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Consultation Type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consultation Type"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnInPerson"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="In-person"
                    android:textAllCaps="false"
                    android:backgroundTint="#1565C0"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnVideoCall"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Video Call"
                    android:textAllCaps="false"
                    android:backgroundTint="#ECEFF1"
                    android:textColor="#546E7A"
                    android:layout_marginStart="8dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Select New Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select New Date"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:rowCount="2"
                android:layout_marginBottom="24dp">

                <TextView android:text="MON" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />
                <TextView android:text="TUE" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />
                <TextView android:text="WED" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />
                <TextView android:text="THU" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />
                <TextView android:text="FRI" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />
                <TextView android:text="SAT" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />
                <TextView android:text="SUN" android:layout_columnWeight="1" android:gravity="center" android:textSize="11sp" android:textColor="#546E7A" android:padding="4dp" />

                <TextView android:id="@+id/date16" android:text="5"  android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_selected" android:textColor="#FFFFFF" android:textStyle="bold" />
                <TextView android:id="@+id/date17" android:text="6"  android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_normal" />
                <TextView android:id="@+id/date18" android:text="7"  android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_normal" />
                <TextView android:id="@+id/date19" android:text="8"  android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_normal" />
                <TextView android:id="@+id/date20" android:text="9"  android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_normal" />
                <TextView android:id="@+id/date21" android:text="10" android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_normal" />
                <TextView android:id="@+id/date22" android:text="11" android:layout_columnWeight="1" android:gravity="center" android:padding="8dp" android:background="@drawable/date_normal" />
            </GridLayout>

            <!-- Available Time Slots -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Slots"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/slot1" android:text="09:00 AM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_selected" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/slot2" android:text="10:00 AM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_normal" android:textSize="12sp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/slot3" android:text="11:00 AM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_normal" android:textSize="12sp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/slot4" android:text="01:30 PM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_normal" android:textSize="12sp" android:layout_marginStart="4dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">
                <TextView android:id="@+id/slot5" android:text="02:00 PM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_normal" android:textSize="12sp" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/slot6" android:text="03:30 PM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_normal" android:textSize="12sp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/slot7" android:text="04:30 PM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:background="@drawable/slot_normal" android:textSize="12sp" android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Notes -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Additional Notes (optional)" android:textSize="16sp" android:textStyle="bold" android:textColor="#212121" android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Any changes to your condition or reason?"
                android:gravity="top|start"
                android:padding="14dp"
                android:background="@drawable/search_background"
                android:backgroundTint="#FFFFFF"
                android:inputType="textMultiLine"
                android:layout_marginBottom="24dp" />

            <!-- Confirm Reschedule -->
            <Button
                android:id="@+id/btnConfirmReschedule"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Confirm Reschedule"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:backgroundTint="#F57C00"
                android:layout_marginBottom="32dp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>

