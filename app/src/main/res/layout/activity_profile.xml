<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <!-- ── Hero Header ── -->
    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#1565C0"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- Top row: title + edit button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="My Profile"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Edit ✏️"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/chip_background"
                android:backgroundTint="#1976D2"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Avatar + info centered -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- Avatar circle with initials -->
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/avatar_circle"
                android:backgroundTint="#1976D2"
                android:gravity="center"
                android:text="U"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:elevation="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="user@example.com"
                    android:textColor="#BBDEFB"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#90CAF9"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Stats Row ── -->
    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_below="@id/profileHeader"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="2dp"
        android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvApptCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#1565C0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appointments" android:textSize="10sp" android:textColor="#546E7A" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="center_vertical" android:background="#ECEFF1" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvDoctorCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#1565C0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doctors Seen" android:textSize="10sp" android:textColor="#546E7A" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="center_vertical" android:background="#ECEFF1" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvBloodType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A+" android:textSize="20sp" android:textStyle="bold" android:textColor="#C62828" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blood Type" android:textSize="10sp" android:textColor="#546E7A" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/statsRow"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Navigation Menu Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Medical Records -->
                    <LinearLayout android:id="@+id/menuMedicalRecords" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗂️" android:textSize="20sp" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Medical Records" android:textSize="15sp" android:textColor="#212121" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="#90A4AE" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginStart="56dp" />

                    <!-- Prescriptions -->
                    <LinearLayout android:id="@+id/menuPrescriptions" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💊" android:textSize="20sp" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Prescriptions" android:textSize="15sp" android:textColor="#212121" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="#90A4AE" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginStart="56dp" />

                    <!-- Notifications -->
                    <LinearLayout android:id="@+id/menuNotifications" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textSize="20sp" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Notifications" android:textSize="15sp" android:textColor="#212121" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="#90A4AE" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginStart="56dp" />

                    <!-- Settings -->
                    <LinearLayout android:id="@+id/menuSettings" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️" android:textSize="20sp" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Settings" android:textSize="15sp" android:textColor="#212121" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="#90A4AE" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginStart="56dp" />

                    <!-- Help -->
                    <LinearLayout android:id="@+id/menuHelp" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❓" android:textSize="20sp" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Help &amp; Support" android:textSize="15sp" android:textColor="#212121" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="#90A4AE" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sign Out"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:backgroundTint="#FFEBEE"
                android:textColor="#C62828"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Navigation ── -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:baselineAligned="false">

        <TextView android:id="@+id/navHome"     android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home"     android:gravity="center" android:textSize="11sp" android:textColor="#888888" app:drawableTopCompat="@drawable/ic_home"     app:drawableTint="#888888" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/navSearch"   android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/search"   android:gravity="center" android:textSize="11sp" android:textColor="#888888" app:drawableTopCompat="@drawable/ic_search"   app:drawableTint="#888888" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/navSchedule" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/schedule" android:gravity="center" android:textSize="11sp" android:textColor="#888888" app:drawableTopCompat="@drawable/ic_schedule" app:drawableTint="#888888" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/navChat"     android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/chat"     android:gravity="center" android:textSize="11sp" android:textColor="#888888" app:drawableTopCompat="@drawable/ic_chat"     app:drawableTint="#888888" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/navProfile"  android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/profile"  android:gravity="center" android:textSize="11sp" android:textColor="#1565C0" android:textStyle="bold" app:drawableTopCompat="@drawable/ic_profile"  app:drawableTint="#1565C0" android:clickable="true" android:focusable="true" />
    </LinearLayout>

</RelativeLayout>
