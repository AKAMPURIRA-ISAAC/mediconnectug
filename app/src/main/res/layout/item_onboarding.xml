<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp"
    android:paddingBottom="16dp">

    <!-- Large health-themed icon circle -->
    <TextView
        android:id="@+id/tvIcon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:text="🏥"
        android:textSize="60sp"
        android:gravity="center"
        android:background="@drawable/avatar_circle"
        android:backgroundTint="#E3F2FD"
        android:layout_marginBottom="44dp" />

    <!-- Title: bold, large -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find Quality Healthcare"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2" />

    <!-- Accent divider line -->
    <View
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#1565C0"
        android:layout_gravity="center_horizontal" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Locate doctors, clinics, and pharmacies in your area with verified reviews."
        android:textSize="15sp"
        android:textColor="#546E7A"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5" />

</LinearLayout>
