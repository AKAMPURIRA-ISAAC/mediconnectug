<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="#003399"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="16dp"
            android:text="@string/app_name"
            android:textColor="#003399"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_favorite_border"
            app:tint="#003399"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_toStartOf="@id/btnFavorite"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#003399"
            android:contentDescription="Edit Doctor Profile"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_toStartOf="@id/btnEdit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_share"
            app:tint="#003399"
            android:contentDescription="@null" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/btnBookAppointment"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Blue Header Background -->
            <View
                android:id="@+id/headerBg"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#003399"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Profile Image -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvDoctorImage"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginStart="24dp"
                app:cardCornerRadius="55dp"
                app:cardElevation="6dp"
                app:layout_constraintTop_toBottomOf="@id/headerBg"
                app:layout_constraintBottom_toBottomOf="@id/headerBg"
                app:layout_constraintStart_toStartOf="parent">
                <ImageView
                    android:id="@+id/ivDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_doctor_avatar"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/doctor_image" />
            </androidx.cardview.widget.CardView>

            <!-- Doctor Info -->
            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:text="@string/dr_sarah_johnson"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/headerBg"
                app:layout_constraintStart_toEndOf="@id/cvDoctorImage"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvSpecialty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/specialty_cardiologist_exp"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvDoctorName"
                app:layout_constraintStart_toStartOf="@id/tvDoctorName"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rating_reviews"
                android:textColor="#888888"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tvSpecialty"
                app:layout_constraintStart_toStartOf="@id/tvDoctorName" />

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/llActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                app:layout_constraintTop_toBottomOf="@id/cvDoctorImage">

                <LinearLayout
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#F8F9FA"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_call" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/call" android:textSize="11sp" android:layout_marginTop="6dp" android:textColor="#003399" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#F8F9FA"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chat" app:tint="#9C27B0" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/message" android:textSize="11sp" android:layout_marginTop="6dp" android:textColor="#9C27B0" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDirection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#F8F9FA"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_direction" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/direction" android:textSize="11sp" android:layout_marginTop="6dp" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/llActions"
                app:tabIndicatorColor="#003399"
                app:tabSelectedTextColor="#003399"
                app:tabTextColor="#888888"
                app:tabMode="fixed"
                app:tabGravity="fill">
                <com.google.android.material.tabs.TabItem android:text="@string/about" />
                <com.google.android.material.tabs.TabItem android:text="@string/availability" />
                <com.google.android.material.tabs.TabItem android:text="@string/reviews" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Biography Section -->
            <TextView
                android:id="@+id/tvBioHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:text="@string/biography"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tabLayout"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvBioContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:text="@string/dr_sarah_bio"
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvBioHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Specialties & Education Row -->
            <LinearLayout
                android:id="@+id/llSpecEdu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                app:layout_constraintTop_toBottomOf="@id/tvBioContent">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/specialties"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            app:drawableStartCompat="@drawable/ic_help"
                            android:drawablePadding="8dp" />
                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/prev_cardiology" android:textSize="10sp" style="@style/Widget.MaterialComponents.Chip.Action" app:chipBackgroundColor="#E3F2FD" app:chipStrokeWidth="0dp" />
                            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/echocardiography" android:textSize="10sp" style="@style/Widget.MaterialComponents.Chip.Action" app:chipBackgroundColor="#E8F5E9" app:chipStrokeWidth="0dp" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F9FA">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/education"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            app:drawableStartCompat="@drawable/ic_help"
                            android:drawablePadding="8dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/harvard" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="12dp" android:textColor="#333333" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/harvard_desc" android:textSize="11sp" android:textColor="#888888" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mayo" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp" android:textColor="#333333" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mayo_desc" android:textSize="11sp" android:textColor="#888888" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Final Step Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E0F7F9"
                app:layout_constraintTop_toBottomOf="@id/llSpecEdu"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="32dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivCheck"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/checkbox_on_background"
                            app:tint="#4CAF50"
                            android:layout_centerVertical="true"
                            android:contentDescription="@null" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivCheck"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/next_step_title"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:textSize="16sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/next_step_desc"
                                android:textColor="#666666"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBookAppointment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:text="@string/book_appointment"
        android:textAllCaps="false"
        android:backgroundTint="#003399"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_schedule"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />

</RelativeLayout>
