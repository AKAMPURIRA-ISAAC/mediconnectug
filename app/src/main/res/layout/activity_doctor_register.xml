<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:tint="#1565C0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Doctor Registration"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />
        </LinearLayout>

        <!-- Blue circle logo -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1565C0"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_doctor"
                android:tint="#FFFFFF"
                android:scaleType="centerCrop"
                android:contentDescription="Doctor Icon" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Your Doctor Account"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Account registration is MANDATORY\n\nHelp patients get better healthcare"
            android:textSize="13sp"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select your hospital, pharmacy, or healthcare facility"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="36dp"
            android:gravity="center" />

        <!-- Full Name Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Full Name (Dr. John Doe)"
                android:inputType="textPersonName"
                android:background="@null"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#BBBBBB"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- Email Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textSize="18sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Professional Email"
                android:inputType="textEmailAddress"
                android:background="@null"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#BBBBBB"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- Phone Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="📱"
                android:textSize="18sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Phone Number"
                android:inputType="phone"
                android:background="@null"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#BBBBBB"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- Specialty Spinner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="🩺"
                android:textSize="18sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <Spinner
                android:id="@+id/spinnerSpecialty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingStart="12dp" />
        </LinearLayout>

         <!-- Hospital/Pharmacy/Healthcare Facility Selection -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="56dp"
             android:orientation="horizontal"
             android:background="@drawable/search_background"
             android:backgroundTint="#FFFFFF"
             android:gravity="center_vertical"
             android:paddingStart="16dp"
             android:paddingEnd="16dp"
             android:layout_marginBottom="16dp">

             <TextView
                 android:layout_width="24dp"
                 android:layout_height="wrap_content"
                 android:text="🏥"
                 android:textSize="18sp"
                 android:textColor="#AAAAAA"
                 android:gravity="center" />

             <Spinner
                 android:id="@+id/etHospital"
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:background="@null"
                 android:paddingStart="12dp" />
         </LinearLayout>

         <!-- Custom Hospital/Pharmacy Name (shown only when "Other" is selected) -->
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="56dp"
             android:orientation="horizontal"
             android:background="@drawable/search_background"
             android:backgroundTint="#FFFFFF"
             android:gravity="center_vertical"
             android:paddingStart="16dp"
             android:paddingEnd="16dp"
             android:layout_marginBottom="16dp"
             android:visibility="gone">

             <TextView
                 android:layout_width="24dp"
                 android:layout_height="wrap_content"
                 android:text="✏️"
                 android:textSize="18sp"
                 android:textColor="#AAAAAA"
                 android:gravity="center" />

             <EditText
                 android:id="@+id/etCustomHospital"
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:hint="Enter hospital, pharmacy, or facility name"
                 android:inputType="text"
                 android:background="@null"
                 android:paddingStart="12dp"
                 android:textSize="15sp"
                 android:textColor="#212121"
                 android:textColorHint="#BBBBBB"
                 android:importantForAutofill="no" />
         </LinearLayout>

        <!-- License Number Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="🆔"
                android:textSize="18sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <EditText
                android:id="@+id/etLicenseNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Medical License Number"
                android:inputType="text"
                android:background="@null"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#BBBBBB"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- Password Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="17sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Password"
                android:inputType="textPassword"
                android:background="@null"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#BBBBBB"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/tvTogglePassword"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="👁"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Confirm Password Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="17sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:background="@null"
                android:paddingStart="12dp"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#BBBBBB"
                android:importantForAutofill="no" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Register as Doctor"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="#1565C0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

