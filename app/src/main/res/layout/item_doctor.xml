<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAvatarInitials"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="DR"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/avatar_circle"
            android:backgroundTint="#1565C0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/vStatusIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/avatar_circle"
            android:backgroundTint="#4CAF50"
            app:layout_constraintBottom_toBottomOf="@id/tvAvatarInitials"
            app:layout_constraintStart_toStartOf="@id/tvAvatarInitials"
            app:layout_constraintEnd_toEndOf="@id/tvAvatarInitials"
            app:layout_constraintHorizontal_bias="0.9"
            android:translationY="4dp" />

        <TextView
            android:id="@+id/tvDoctorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Dr. Sarah Nakigozi"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tvAvatarInitials"
            app:layout_constraintTop_toTopOf="@id/tvAvatarInitials"
            app:layout_constraintEnd_toStartOf="@+id/btnBook" />

        <TextView
            android:id="@+id/tvSpecialty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Pediatrician"
            android:textColor="#888888"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvDoctorName"
            app:layout_constraintTop_toBottomOf="@id/tvDoctorName"
            app:layout_constraintEnd_toStartOf="@+id/btnBook" />

        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="#FF9800"
            android:contentDescription="@null"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvDoctorName"
            app:layout_constraintTop_toBottomOf="@id/tvSpecialty" />

        <TextView
            android:id="@+id/tvRatingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.8"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/ivStar"
            app:layout_constraintTop_toTopOf="@id/ivStar"
            app:layout_constraintBottom_toBottomOf="@id/ivStar" />

        <TextView
            android:id="@+id/tvReviewCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(124 reviews)"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/tvRatingValue"
            app:layout_constraintTop_toTopOf="@id/tvRatingValue"
            app:layout_constraintBottom_toBottomOf="@id/tvRatingValue" />

        <ImageView
            android:id="@+id/ivLocation"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="#888888"
            android:contentDescription="@null"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tvDoctorName"
            app:layout_constraintTop_toBottomOf="@id/ivStar" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.5km"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/ivLocation"
            app:layout_constraintTop_toTopOf="@id/ivLocation"
            app:layout_constraintBottom_toBottomOf="@id/ivLocation" />

        <TextView
            android:id="@+id/tvFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UGX 50,000"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/tvDistance"
            app:layout_constraintTop_toTopOf="@id/tvDistance"
            app:layout_constraintBottom_toBottomOf="@id/tvDistance" />

        <Button
            android:id="@+id/btnBook"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/book"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#2196F3"
            app:strokeColor="#2196F3"
            app:cornerRadius="12dp"
            android:padding="0dp"
            android:minWidth="60dp"
            android:minHeight="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
